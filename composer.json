{
    "name": "allgorithm/filament-actionguard",
    "description": "Stop incomplete records and prevent data degradation across critical Filament actions.",
    "type": "filament-plugin",
    "license": "MIT",
    "homepage": "https://github.com/allgorithm/filament-actionguard",
    "support": {
        "issues": "https://github.com/allgorithm/filament-actionguard/issues",
        "source": "https://github.com/allgorithm/filament-actionguard"
    },
    "authors": [
        {
            "name": "Alex Krivonos",
            "role": "Developer"
        }
    ],
    "keywords": [
        "laravel",
        "filament",
        "filament-5",
        "filament-plugin",
        "action-guard",
        "preflight",
        "validation"
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Allgorithm\\FilamentActionGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Allgorithm\\FilamentActionGuard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Allgorithm\\FilamentActionGuard\\ActionGuardServiceProvider"
            ]
        },
        "filament": {
            "id": "filament-actionguard"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "allgorithm/business-core": "Required only for the licensed Enterprise Bridge (^1.2); Community checks work without it."
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi --memory-limit=512M"
        ],
        "format": "@php vendor/bin/pint --ansi",
        "security-audit": "@composer audit --locked",
        "test": "@php vendor/bin/pest"
    }
}
